# ---------- Build output ----------
/build/
/build-*/
/out/
/out-*/
/bin/
/lib/
/install/
/_build/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.pdb
*.ilk
*.exp
*.idb
*.gch
*.pch

# ---------- CMake ----------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
*.cmake.stamp
!cmake/*.cmake
!**/CMakeLists.txt

# ---------- CMake presets user overrides ----------
CMakeUserPresets.json

# ---------- Visual Studio ----------
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json

# ---------- JetBrains / CLion ----------
.idea/
*.iws
*.iml
*.ipr
cmake-build-*/

# ---------- Xcode ----------
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/

# ---------- Qt ----------
*.pro.user
*.pro.user.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc

