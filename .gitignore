# Compiled shaders
*.spv
*.glsl.spv
*.hlsl.spv
*.cso
*.dxil
*.metal.ar

# Shader caches
/shader_cache/
*.shadercache

# Compiled assets / cooked data
/cooked/
/Cooked/
/assets-cooked/
*.cooked
*.pak
*.nukepak

# Asset import caches
/import_cache/
/Library/
/Temp/
/Obj/
/Logs/
/UserSettings/
/Build/
/Builds/

# ---------- Logs / dumps ----------
*.log
*.dmp
*.stackdump
crash-*
/core
core.[0-9]*
vgcore.*
*.trace

# ---------- Test / coverage ----------
/Testing/
*.gcda
*.gcno
*.gcov
coverage/
*.profraw
*.profdata
lcov.info

# ---------- Benchmarks ----------
*.bench.json

# ---------- Dependencies (if vendored) ----------
