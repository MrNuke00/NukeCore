# /_deps/
# /third_party/_deps/

# ---------- Conan / vcpkg ----------
conan.lock
conanbuildinfo.*
conaninfo.txt
graph_info.json
/vcpkg_installed/
vcpkg-manifest-install.log

# ---------- Env / secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# ---------- OS junk ----------
